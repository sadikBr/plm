#!/usr/bin/env bash
# plm: install, start, stop and look after the whole platform on this computer.
#
#   ./plm install [--lite] [--yes] [--dry-run]
#                          install what's missing (Git, Docker, JDK 21, Node.js), build, start,
#                          and choose the site administrator's password: the one command to begin with
#   ./plm start [--lite]   start the services, the backend and the web UI, and wait until they're ready
#   ./plm stop             stop the web UI, the backend and the services (data is kept)
#   ./plm restart [--lite] stop, then start
#   ./plm status           what's running, and where
#   ./plm logs [backend|ui|services]   follow a log (Ctrl-C to stop following)
#   ./plm admin-password   change the site administrator's (plmadmin's) password, or set a forgotten one
#   ./plm load-data [voltara|byd] [--company "Name"]
#                          load demo data: an EV maker (fictional, or BYD with its real car names), its plant
#   ./plm setup            only check the prerequisites, install the dependencies, build the backend
#   ./plm reset            stop everything and delete all local data (asks first)
#
# --lite starts fewer services (no OpenSearch, no Temporal): about 3 GB less memory. --yes answers
# yes to every question; --dry-run only shows what install would do. On Windows, use plm.cmd.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STATE="$ROOT/.plm"
mkdir -p "$STATE"
COMPOSE=(docker compose -f "$ROOT/deploy/docker-compose.yml")
UI_URL="http://localhost:5173"
API_URL="http://localhost:8080"
KEYCLOAK="http://localhost:8180"
ADMIN_USER="plmadmin"

COMMAND="${1:-}"
LITE=0
ASSUME_YES=0
DRY_RUN=0
for arg in "$@"; do
  case "$arg" in
    --lite) LITE=1 ;;
    --yes | -y) ASSUME_YES=1 ;;
    --dry-run) DRY_RUN=1 ;;
  esac
done

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
ok() { printf '  \033[32m✓\033[0m %s\n' "$*"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$*"; }
fail() {
  printf '  \033[31m✗\033[0m %s\n' "$*" >&2
  exit 1
}

# Asks a yes/no question; $2 is the answer when nobody can be asked (Y or N).
confirm() {
  local question="$1" default="${2:-Y}" answer hint="[Y/n]"
  [[ "$default" == N ]] && hint="[y/N]"
  if [[ "$ASSUME_YES" == 1 ]]; then return 0; fi
  if [[ ! -t 0 ]]; then [[ "$default" == Y ]]; return; fi
  read -r -p "  $question $hint " answer
  answer="${answer:-$default}"
  [[ "$answer" =~ ^[Yy] ]]
}

# Runs a command as root (with sudo unless we are root); --dry-run only prints it.
as_root() {
  if [[ "$DRY_RUN" == 1 ]]; then
    printf '    would run: %s\n' "$*"
    return 0
  fi
  if [[ "$(id -u)" == 0 ]]; then "$@"; else sudo "$@"; fi
}
# The same for a shell snippet (pipes, redirections).
as_root_sh() {
  if [[ "$DRY_RUN" == 1 ]]; then
    printf '    would run: %s\n' "$1"
    return 0
  fi
  if [[ "$(id -u)" == 0 ]]; then bash -o pipefail -c "$1"; else sudo bash -o pipefail -c "$1"; fi
}
# Downloads an installer script and runs it as root; a failed download stops (unlike curl | sh).
run_installer() {
  local url="$1" script
  shift
  if [[ "$DRY_RUN" == 1 ]]; then
    printf '    would run: the installer from %s\n' "$url"
    return 0
  fi
  script="$(mktemp)"
  curl -fsSL --retry 3 -o "$script" "$url" || {
    rm -f "$script"
    warn "Couldn't download $url"
    return 1
  }
  as_root bash "$script" "$@"
  local code=$?
  rm -f "$script"
  return $code
}
# A command as this user (Homebrew refuses to run as root); --dry-run only prints it.
as_me() {
  if [[ "$DRY_RUN" == 1 ]]; then
    printf '    would run: %s\n' "$*"
    return 0
  fi
  "$@"
}

# ---- processes we started: a pid file each ----
pid_of() { cat "$STATE/$1.pid" 2>/dev/null || true; }
running() {
  local pid
  pid="$(pid_of "$1")"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}
stop_process() {
  local name="$1" pid
  pid="$(pid_of "$name")"
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
    for _ in $(seq 1 30); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 1
    done
    kill -9 "$pid" 2>/dev/null || true
    ok "$name stopped"
  fi
  rm -f "$STATE/$name.pid"
}

# Waits up to $2 seconds for $1 (a command) to succeed.
wait_for() {
  local check="$1" seconds="$2" what="$3"
  for _ in $(seq 1 "$seconds"); do
    if eval "$check" >/dev/null 2>&1; then
      ok "$what"
      return 0
    fi
    sleep 1
  done
  return 1
}
port_open() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }
http_ok() { curl -fsS -o /dev/null --max-time 3 "$1" 2>/dev/null; }

# ---- what this computer has ----
OS="$(uname -s)"
is_wsl() { [[ "$OS" == Linux ]] && { [[ -n "${WSL_DISTRO_NAME:-}" ]] || grep -qi microsoft /proc/version 2>/dev/null; }; }

# The system's package manager: brew, apt, dnf, pacman, or empty.
package_manager() {
  if [[ "$OS" == Darwin ]]; then
    echo brew
  elif command -v apt-get >/dev/null 2>&1; then
    echo apt
  elif command -v dnf >/dev/null 2>&1; then
    echo dnf
  elif command -v pacman >/dev/null 2>&1; then
    echo pacman
  fi
}

# Java: the one on PATH if it's 21 or newer, else a JDK 21+ installed beside an older default
# (then JAVA_HOME points at it, for the build too).
JAVA=""
java_major() { "$1" -version 2>&1 | awk -F'"' '/version/ {print $2; exit}' | sed 's/^1\./1/' | cut -d. -f1; }
find_java() {
  local c v real
  for c in "$(command -v java 2>/dev/null || true)" ${JAVA_HOME:+"$JAVA_HOME/bin/java"} \
    /usr/lib/jvm/*/bin/java /Library/Java/JavaVirtualMachines/*/Contents/Home/bin/java \
    /opt/homebrew/opt/openjdk@21/bin/java /usr/local/opt/openjdk@21/bin/java; do
    [[ -n "$c" && -x "$c" ]] || continue
    # A JDK, not just a runtime: Fedora's java-NN-openjdk has no compiler (that's in -devel).
    real="$(readlink -f "$c" 2>/dev/null || echo "$c")"
    [[ -x "$(dirname "$real")/javac" ]] || continue
    v="$(java_major "$c")"
    if [[ "${v:-0}" =~ ^[0-9]+$ && "$v" -ge 21 ]]; then
      JAVA="$c"
      if [[ "$c" != "$(command -v java 2>/dev/null || true)" ]]; then
        JAVA_HOME="$(cd "$(dirname "$real")/.." && pwd)"
        export JAVA_HOME
      fi
      return 0
    fi
  done
  return 1
}
node_ok() { command -v node >/dev/null 2>&1 && [[ "$(node -p 'process.versions.node.split(".")[0]')" -ge 22 ]]; }
git_ok() { git --version >/dev/null 2>&1; }
docker_installed() { command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; }
# Docker Desktop on macOS links its commands into PATH only once it has run; until then, they're here.
docker_desktop_app() { [[ "$OS" == Darwin && -d /Applications/Docker.app ]]; }
if docker_desktop_app && ! command -v docker >/dev/null 2>&1; then PATH="$PATH:/Applications/Docker.app/Contents/Resources/bin"; fi

# ---- WSL: Docker comes from Docker Desktop on Windows ----
# Windows' PowerShell, reached from WSL.
windows_powershell() {
  local p
  for p in "$(command -v powershell.exe 2>/dev/null || true)" /mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe; do
    if [[ -n "$p" && -x "$p" ]]; then
      echo "$p"
      return 0
    fi
  done
  return 1
}
# Docker Desktop's program on Windows, as a WSL path.
windows_docker_desktop() {
  is_wsl || return 1
  local exe="/mnt/c/Program Files/Docker/Docker/Docker Desktop.exe" ps pf
  if [[ ! -f "$exe" ]] && ps="$(windows_powershell)"; then
    pf="$("$ps" -NoProfile -Command '$env:ProgramFiles' 2>/dev/null | tr -d '\r')"
    [[ -n "$pf" ]] && exe="$(wslpath -u "$pf" 2>/dev/null)/Docker/Docker/Docker Desktop.exe"
  fi
  [[ -f "$exe" ]] && echo "$exe"
}
# A Docker engine installed inside this WSL distribution itself, rather than Docker Desktop.
wsl_own_docker() { is_wsl && [[ -f /lib/systemd/system/docker.service || -f /usr/lib/systemd/system/docker.service ]]; }
wsl_integration_help() {
  echo "Docker Desktop is installed but doesn't answer in WSL. In Docker Desktop: Settings › Resources ›" \
    "WSL integration: turn on ${WSL_DISTRO_NAME:-this distribution}, Apply & restart (no such page? Settings › General: tick" \
    "\"Use the WSL 2 based engine\" first); then run ./plm ${COMMAND} again" \
    "(if Docker Desktop asked you to sign out of Windows or restart it, do that first)"
}
install_docker_desktop_from_wsl() {
  local ps
  ps="$(windows_powershell)" || {
    warn "WSL can't run Windows programs here: install Docker Desktop on Windows (winget install Docker.DockerDesktop)"
    return 1
  }
  as_me "$ps" -NoProfile -Command "winget install --id Docker.DockerDesktop -e --accept-source-agreements --accept-package-agreements" || true
  [[ "$DRY_RUN" == 1 ]] || windows_docker_desktop >/dev/null
}

# ---- prerequisites: check (start) ----
check_prerequisites() {
  bold "Checking prerequisites"
  command -v docker >/dev/null || windows_docker_desktop >/dev/null || fail "Docker isn't installed: run ./plm install, or see README.md"
  ensure_docker_running
  docker compose version >/dev/null 2>&1 || fail "Docker Compose v2 is missing: run ./plm install, or see README.md"
  ok "Docker $(docker version --format '{{.Server.Version}}' 2>/dev/null)"
  find_java || fail "JDK 21 or newer isn't installed: run ./plm install, or see README.md"
  ok "Java $(java_major "$JAVA")${JAVA_HOME:+ ($JAVA_HOME)}"
  node_ok || fail "Node.js 22 or newer isn't installed: run ./plm install, or see README.md"
  ok "Node.js $(node --version)"
  command -v curl >/dev/null || fail "curl isn't installed: run ./plm install"
}

# ---- prerequisites: install (install) ----
# Installs one prerequisite ($1: git, curl, java, node, docker) with the package manager $2.
install_one() {
  local what="$1" pm="$2"
  case "$pm:$what" in
    wsl:docker) install_docker_desktop_from_wsl ;;
    brew:git) as_me brew install git ;;
    brew:curl) as_me brew install curl ;;
    brew:java) as_me brew install --cask temurin@21 ;;
    brew:node) as_me brew install node ;;
    brew:docker) as_me brew install --cask docker ;;

    apt:git | apt:curl) as_root apt-get install -y "$what" ca-certificates ;;
    apt:java)
      as_root apt-get install -y openjdk-21-jdk-headless || {
        # Debian 12 and older releases: Eclipse Temurin's repository.
        as_root apt-get install -y wget gpg ca-certificates
        as_root_sh "wget -qO - https://packages.adoptium.net/artifactory/api/gpg/key/public | gpg --dearmor > /etc/apt/trusted.gpg.d/adoptium.gpg"
        as_root_sh "echo \"deb https://packages.adoptium.net/artifactory/deb \$(. /etc/os-release && echo \$VERSION_CODENAME) main\" > /etc/apt/sources.list.d/adoptium.list"
        as_root apt-get update
        as_root apt-get install -y temurin-21-jdk
      }
      ;;
    apt:node | dnf:node)
      local repo="deb"
      [[ "$pm" == dnf ]] && repo="rpm"
      run_installer "https://$repo.nodesource.com/setup_22.x" || return 1
      if [[ "$pm" == apt ]]; then as_root apt-get install -y nodejs; else as_root dnf install -y nodejs; fi
      ;;
    apt:docker | dnf:docker) run_installer https://get.docker.com ;;

    dnf:git | dnf:curl) as_root dnf install -y "$what" ;;
    # The -devel package is the JDK (with javac); the plain one is only the runtime.
    dnf:java) as_root dnf install -y java-21-openjdk-devel || as_root dnf install -y java-25-openjdk-devel ||
      as_root dnf install -y java-latest-openjdk-devel ;;

    pacman:git | pacman:curl) as_root pacman -S --needed --noconfirm "$what" ;;
    pacman:java) as_root pacman -S --needed --noconfirm jdk21-openjdk ;;
    pacman:node) as_root pacman -S --needed --noconfirm nodejs npm ;;
    pacman:docker) as_root pacman -S --needed --noconfirm docker docker-compose ;;
    *) return 1 ;;
  esac
}

# Makes sure Docker's daemon runs and this user may use it.
ensure_docker_running() {
  docker info >/dev/null 2>&1 && return 0
  if [[ "$OS" == Darwin ]]; then
    echo "  Starting Docker Desktop (the first time, accept its terms in the window that opens)"
    [[ "$DRY_RUN" == 1 ]] && return 0
    open -a Docker 2>/dev/null || open -a OrbStack 2>/dev/null || true
    wait_for "docker info" 240 "Docker is running" || fail "Docker didn't start: open Docker Desktop, wait until it's ready, and run ./plm install again"
    return 0
  fi
  if is_wsl && ! wsl_own_docker; then
    local exe
    exe="$(windows_docker_desktop)" || fail "Docker Desktop for Windows isn't installed: run ./plm install"
    echo "  Starting Docker Desktop on Windows (if a window asks you to accept its terms, do so)"
    [[ "$DRY_RUN" == 1 ]] && return 0
    "$(windows_powershell)" -NoProfile -Command "Start-Process '$(wslpath -w "$exe")'" >/dev/null 2>&1 || true
    echo "  Waiting for Docker to answer in ${WSL_DISTRO_NAME:-WSL}..."
    # Docker Desktop's own command on Windows: it answers once the engine runs, WSL integration or not.
    local windows_docker told=0 i
    windows_docker="$(dirname "$exe")/resources/bin/docker.exe"
    local err shown_err="" restart_told=0
    for i in $(seq 1 600); do
      if err="$(docker info 2>&1 >/dev/null)"; then
        ok "Docker is running"
        return 0
      fi
      if [[ $((i % 5)) == 0 ]] && command -v docker >/dev/null 2>&1; then
        case "$err" in
          *"permission denied"*)
            warn "Docker answers, but $(id -un) may not use it yet (permission denied)."
            join_docker_group
            ;;
          *"could not be found in this WSL"* | *"Cannot connect"* | "") ;;
          *)
            if [[ "$err" != "$shown_err" ]]; then
              warn "Docker says: $(printf '%s' "$err" | head -n 2 | tr '\n' ' ')"
              shown_err="$err"
            fi
            ;;
        esac
      fi
      # Integration turned on a while ago, still no Docker here: WSL needs a restart to pick it up.
      if [[ "$told" == 1 && "$restart_told" == 0 && $i -ge 90 ]]; then
        warn "Still nothing in ${WSL_DISTRO_NAME:-WSL}. If WSL integration is on already, restart WSL: close this"
        warn "terminal, run  wsl --shutdown  in Windows PowerShell, open ${WSL_DISTRO_NAME:-Ubuntu} again and run ./plm $COMMAND."
        restart_told=1
      fi
      if [[ "$told" == 0 && $((i % 5)) == 0 && -f "$windows_docker" ]] && "$windows_docker" info >/dev/null 2>&1; then
        warn "Docker Desktop runs on Windows, but isn't connected to ${WSL_DISTRO_NAME:-this distribution} yet. In Docker Desktop:"
        warn "Settings (the gear, top right) › Resources › WSL integration: turn on ${WSL_DISTRO_NAME:-this distribution}, then Apply & restart."
        warn "(No WSL integration there? Settings › General: tick \"Use the WSL 2 based engine\" first.)"
        echo "  Waiting until that's done (Ctrl-C stops; ./plm install carries on later)..."
        told=1
      fi
      sleep 1
    done
    fail "$(wsl_integration_help)"
  fi
  if ! as_root docker info >/dev/null 2>&1; then
    echo "  Starting the Docker service"
    as_root systemctl enable --now docker || fail "The Docker service didn't start: sudo systemctl status docker"
  fi
  [[ "$DRY_RUN" == 1 ]] && return 0
  docker info >/dev/null 2>&1 && return 0
  join_docker_group
}

# Docker runs, but this user may not use it ("permission denied"): join the docker group, and
# carry on inside it.
join_docker_group() {
  getent group docker >/dev/null 2>&1 || as_root groupadd docker
  if ! id -nG | tr ' ' '\n' | grep -qx docker; then
    echo "  Letting $(id -un) use Docker (the docker group)"
    as_root usermod -aG docker "$(id -un)"
  fi
  # The group counts from the next login; until then, carry on inside it.
  if command -v sg >/dev/null 2>&1 && [[ -z "${PLM_IN_DOCKER_GROUP:-}" ]]; then
    echo "  (continuing in the docker group; from your next login it's yours everywhere)"
    local flags=()
    [[ "$LITE" == 1 ]] && flags+=(--lite)
    [[ "$ASSUME_YES" == 1 ]] && flags+=(--yes)
    export PLM_IN_DOCKER_GROUP=1
    exec sg docker -c "$(printf '%q ' "$0" "$COMMAND" ${flags[@]+"${flags[@]}"})"
  fi
  fail "You were added to the docker group: log out and back in, then run ./plm $COMMAND again"
}

label() {
  case "$1" in
    git) echo "Git" ;;
    curl) echo "curl" ;;
    docker) if is_wsl; then echo "Docker Desktop (on Windows)"; else echo "Docker"; fi ;;
    java) echo "JDK 21" ;;
    node) echo "Node.js 22" ;;
  esac
}

ensure_prerequisites() {
  bold "Checking prerequisites"
  local pm missing=()
  pm="$(package_manager)"
  git_ok && ok "Git" || missing+=(git)
  command -v curl >/dev/null 2>&1 && ok "curl" || missing+=(curl)
  if docker_installed || docker_desktop_app || windows_docker_desktop >/dev/null; then ok "Docker"; else missing+=(docker); fi
  if find_java; then ok "Java $(java_major "$JAVA")"; else missing+=(java); fi
  if node_ok; then ok "Node.js $(node --version)"; else missing+=(node); fi

  local m
  if [[ ${#missing[@]} -gt 0 ]]; then
    local names=()
    for m in "${missing[@]}"; do names+=("$(label "$m")"); done
    echo
    if [[ -z "$pm" ]]; then
      fail "Missing: $(printf '%s, ' "${names[@]}" | sed 's/, $//'). This system has no package manager plm knows (apt, dnf, pacman, Homebrew): install them as README.md says, then run ./plm install again"
    fi
    if [[ "$pm" == brew ]] && ! command -v brew >/dev/null 2>&1; then
      echo "  Missing: $(printf '%s, ' "${names[@]}" | sed 's/, $//'). They're installed with Homebrew, which isn't installed yet."
      confirm "Install Homebrew first (it asks for your password)?" || fail "Install Homebrew (https://brew.sh), then run ./plm install again"
      if [[ "$DRY_RUN" == 1 ]]; then
        echo "    would run: the Homebrew installer from https://brew.sh"
      else
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        local b
        for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do [[ -x "$b" ]] && eval "$("$b" shellenv)"; done
      fi
    fi
    # In WSL, Docker Desktop comes from winget on Windows; the rest from the package manager.
    local via_pm=0 how=""
    for m in "${missing[@]}"; do
      if [[ "$m" != docker ]] || ! is_wsl; then via_pm=1; fi
    done
    if [[ "$via_pm" == 1 ]]; then
      how="with $pm"
      if [[ "$pm" != brew && "$(id -u)" != 0 ]]; then how="$how (it asks for your password: sudo)"; fi
    fi
    if is_wsl && [[ " ${missing[*]} " == *" docker "* ]]; then
      if [[ "$via_pm" == 1 ]]; then
        how="$how; Docker Desktop with winget, on Windows (Windows asks for permission)"
      else
        how="with winget, on Windows (Windows asks for permission)"
      fi
    fi
    echo "  To install: $(printf '%s, ' "${names[@]}" | sed 's/, $//'); $how."
    confirm "Install them now?" || fail "Nothing installed. README.md lists the commands to install them yourself."
    if [[ "$pm" == apt && "$via_pm" == 1 ]]; then as_root apt-get update; fi
    local failed=()
    for m in "${missing[@]}"; do
      bold "Installing $(label "$m")"
      local with="$pm"
      if [[ "$m" == docker ]] && is_wsl; then with=wsl; fi
      install_one "$m" "$with" || failed+=("$(label "$m")")
    done
    if [[ ${#failed[@]} -gt 0 ]]; then
      fail "Installing $(printf '%s, ' "${failed[@]}" | sed 's/, $//') failed: see the messages above, or README.md to do it by hand, then run ./plm install again"
    fi
    [[ "$DRY_RUN" == 1 ]] && return 0
    hash -r
    git_ok || fail "Git still isn't there: see README.md"
    docker_installed || docker_desktop_app || windows_docker_desktop >/dev/null || fail "Docker still isn't there: see README.md"
    find_java || fail "JDK 21 still isn't there: see README.md"
    node_ok || fail "Node.js 22 still isn't there: see README.md"
    ok "Everything's installed"
  fi
  ensure_docker_running
  [[ "$DRY_RUN" == 1 ]] && return 0
  docker compose version >/dev/null 2>&1 || fail "Docker Compose v2 is missing: update Docker (see README.md)"
  ok "Docker $(docker version --format '{{.Server.Version}}' 2>/dev/null) is running"

  # Memory: the full set of services wants about 8 GB.
  local mem
  mem="$(docker info --format '{{.MemTotal}}' 2>/dev/null || echo 0)"
  if [[ "$LITE" != 1 && "$mem" =~ ^[0-9]+$ && "$mem" -gt 0 && "$mem" -lt 7000000000 ]]; then
    warn "Docker has $((mem / 1000000000)) GB of memory; all the services need about 8 GB."
    if confirm "Start with fewer services (--lite: search in Postgres, workflows in the backend)?"; then
      LITE=1
    fi
  fi
}

install_dependencies() {
  bold "Installing dependencies"
  if [[ ! -d "$ROOT/frontend/node_modules" || "$ROOT/frontend/package-lock.json" -nt "$ROOT/frontend/node_modules" ]]; then
    (cd "$ROOT/frontend" && npm ci --no-audit --no-fund) || fail "Installing the web UI's packages failed"
  fi
  ok "Web UI packages"
  if [[ ! -d "$ROOT/workers/cad-converter/node_modules" || "$ROOT/workers/cad-converter/package-lock.json" -nt "$ROOT/workers/cad-converter/node_modules" ]]; then
    (cd "$ROOT/workers/cad-converter" && npm ci --no-audit --no-fund) || warn "The CAD converter didn't install: 3D views won't be made"
  fi
  ok "CAD converter"
}

build_backend() {
  bold "Building the backend"
  echo "  (the first build downloads dependencies and takes a few minutes)"
  (cd "$ROOT" && ./gradlew -q :backend:app:bootJar) >"$STATE/build.log" 2>&1 || {
    tail -n 30 "$STATE/build.log" >&2
    fail "The backend didn't build: see .plm/build.log"
  }
  ok "backend/app/build/libs/app.jar"
}

# ---- start ----
start_services() {
  bold "Starting the services"
  if [[ "$LITE" == 1 ]]; then
    "${COMPOSE[@]}" up -d >/dev/null 2>&1 || "${COMPOSE[@]}" up -d
  else
    "${COMPOSE[@]}" --profile full up -d >/dev/null 2>&1 || "${COMPOSE[@]}" --profile full up -d
  fi
  wait_for "port_open 5432" 120 "PostgreSQL on :5432" || fail "PostgreSQL didn't start: ./plm logs services"
  wait_for "http_ok $KEYCLOAK/realms/plm/.well-known/openid-configuration" 180 "Keycloak on :8180" ||
    fail "Keycloak didn't start: ./plm logs services"
  wait_for "port_open 8333" 60 "S3 storage on :8333" || warn "S3 storage isn't answering yet"
  wait_for "port_open 19092" 60 "Redpanda on :19092" || warn "Redpanda isn't answering yet (events wait in the outbox)"
  if [[ "$LITE" != 1 ]]; then
    wait_for "http_ok http://localhost:9200" 180 "OpenSearch on :9200" || fail "OpenSearch didn't start: try ./plm start --lite"
    wait_for "port_open 7233" 120 "Temporal on :7233" || fail "Temporal didn't start: try ./plm start --lite"
  fi
}

start_backend() {
  bold "Starting the backend"
  if running backend; then
    ok "already running (pid $(pid_of backend))"
    return
  fi
  port_open 8080 && fail "Something else is using port 8080: stop it first"
  local env=()
  if [[ "$LITE" != 1 ]]; then env=(PLM_SEARCH_ENGINE=opensearch PLM_TEMPORAL_TARGET=localhost:7233); fi
  echo "$LITE" >"$STATE/mode"
  # Only the command is put in the background, so $! is its own pid (env and nohup exec into java).
  (
    cd "$ROOT" || exit 1
    env ${env[@]+"${env[@]}"} nohup "$JAVA" -jar backend/app/build/libs/app.jar >"$STATE/backend.log" 2>&1 </dev/null &
    echo $! >"$STATE/backend.pid"
  )
  wait_for "http_ok $API_URL/actuator/health" 240 "Backend on :8080" || {
    tail -n 30 "$STATE/backend.log" >&2
    fail "The backend didn't come up: see .plm/backend.log"
  }
}

start_ui() {
  bold "Starting the web UI"
  if running ui; then
    ok "already running (pid $(pid_of ui))"
    return
  fi
  port_open 5173 && fail "Something else is using port 5173: stop it first"
  (
    cd "$ROOT/frontend" || exit 1
    nohup node node_modules/vite/bin/vite.js --port 5173 --strictPort >"$STATE/ui.log" 2>&1 </dev/null &
    echo $! >"$STATE/ui.pid"
  )
  wait_for "http_ok $UI_URL" 60 "Web UI on :5173" || {
    tail -n 20 "$STATE/ui.log" >&2
    fail "The web UI didn't come up: see .plm/ui.log"
  }
}

start_everything() {
  install_dependencies
  build_backend
  start_services
  start_backend
  start_ui
}

ready_message() {
  echo
  bold "The platform is ready: $UI_URL"
  if [[ "${1:-}" == set ]]; then
    echo "  Sign in as $ADMIN_USER, the site administrator, with the password you chose."
  else
    echo "  Sign in as $ADMIN_USER, the site administrator: the first time with the password $ADMIN_USER,"
    echo "  after which it asks you to choose your own (or run ./plm admin-password)."
  fi
  echo "  Users alice, bob and carol: password = user name."
  echo "  API $API_URL/swagger-ui.html · mail http://localhost:8025$([[ $LITE == 1 ]] || echo ' · workflows http://localhost:8233')"
  echo "  ./plm status · ./plm logs backend · ./plm stop"
}

cmd_start() {
  check_prerequisites
  start_everything
  ready_message
}

# ---- the site administrator's password (Keycloak's admin API) ----
# Reads a JSON value from stdin at a dotted path (0.id).
json() {
  node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{let x=JSON.parse(s||"null");for(const k of process.argv[1].split("."))x=x==null?x:x[k];process.stdout.write(x==null?"":typeof x=="object"?JSON.stringify(x):String(x))})' "$1"
}
keycloak_admin_token() {
  curl -fsS --max-time 10 -d client_id=admin-cli -d grant_type=password \
    --data-urlencode "username=${KEYCLOAK_ADMIN_USER:-admin}" --data-urlencode "password=${KEYCLOAK_ADMIN_PASSWORD:-admin}" \
    "$KEYCLOAK/realms/master/protocol/openid-connect/token" | json access_token
}
# Prints plmadmin's Keycloak user as JSON.
admin_user() {
  curl -fsS --max-time 10 -H "Authorization: Bearer $1" "$KEYCLOAK/admin/realms/plm/users?username=$ADMIN_USER&exact=true" | json 0
}

# Asks for a new password twice; prints it.
ask_password() {
  local first second
  for _ in 1 2 3; do
    read -r -s -p "  New password for $ADMIN_USER (8 characters or more): " first </dev/tty
    echo >/dev/tty
    if [[ ${#first} -lt 8 ]]; then
      echo "  Too short." >/dev/tty
      continue
    fi
    if [[ "$first" == "$ADMIN_USER" ]]; then
      echo "  Choose something other than its first password." >/dev/tty
      continue
    fi
    read -r -s -p "  The same again: " second </dev/tty
    echo >/dev/tty
    if [[ "$first" != "$second" ]]; then
      echo "  They differ." >/dev/tty
      continue
    fi
    printf '%s' "$first"
    return 0
  done
  return 1
}

# Sets plmadmin's password. $1: "ask" (only if it still has its first one) or "always".
# Succeeds when plmadmin has a password of its own (set now or before), fails if it keeps the first.
set_admin_password() {
  local when="$1" token user id first password
  bold "The site administrator's password"
  wait_for "http_ok $KEYCLOAK/realms/plm/.well-known/openid-configuration" 120 "Keycloak is answering" ||
    fail "Keycloak isn't running: ./plm start first"
  token="$(keycloak_admin_token)" || true
  [[ -n "$token" ]] || fail "Keycloak's own admin account didn't sign in (KEYCLOAK_ADMIN_USER / KEYCLOAK_ADMIN_PASSWORD)"
  user="$(admin_user "$token")"
  id="$(printf '%s' "$user" | json id)"
  [[ -n "$id" ]] || fail "There's no $ADMIN_USER in Keycloak: see Troubleshooting in docs/DEVELOPMENT.md"
  first="$(printf '%s' "$user" | json requiredActions)"
  if [[ "$when" == ask && "$first" != *UPDATE_PASSWORD* ]]; then
    ok "$ADMIN_USER already has its own password (change it with ./plm admin-password)"
    return 0
  fi
  if [[ -n "${PLM_ADMIN_PASSWORD:-}" && "$PLM_ADMIN_PASSWORD" != "$ADMIN_USER" ]]; then
    password="$PLM_ADMIN_PASSWORD"
    echo "  Using PLM_ADMIN_PASSWORD."
  elif [[ -t 0 ]] && [[ "$ASSUME_YES" != 1 || "$when" == always ]]; then
    echo "  $ADMIN_USER is the one account that administers the site. Choose its password:"
    password="$(ask_password)" || fail "No password set: run ./plm admin-password to try again"
  else
    warn "$ADMIN_USER keeps its first password, $ADMIN_USER: it asks for a new one at the first sign-in"
    return 1
  fi
  PLM_NEW_PASSWORD="$password" node -e 'process.stdout.write(JSON.stringify({type:"password",value:process.env.PLM_NEW_PASSWORD,temporary:false}))' |
    curl -fsS --max-time 10 -X PUT -H "Authorization: Bearer $token" -H 'Content-Type: application/json' --data-binary @- \
      "$KEYCLOAK/admin/realms/plm/users/$id/reset-password" ||
    fail "Keycloak refused the password"
  # The first-sign-in request for a new password is done with.
  curl -fsS --max-time 10 -X PUT -H "Authorization: Bearer $token" -H 'Content-Type: application/json' \
    -d '{"requiredActions":[]}' "$KEYCLOAK/admin/realms/plm/users/$id" || true
  ok "$ADMIN_USER's password is set"
  echo "  (scripts and end-to-end tests read it from PLM_ADMIN_PASSWORD)"
  return 0
}

cmd_admin_password() {
  command -v node >/dev/null || fail "Node.js is needed: run ./plm install"
  if ! http_ok "$KEYCLOAK/realms/plm/.well-known/openid-configuration"; then
    echo "  Starting Keycloak"
    "${COMPOSE[@]}" up -d keycloak >/dev/null 2>&1 || fail "Keycloak didn't start: is Docker running?"
  fi
  set_admin_password always || true
}

cmd_load_data() {
  command -v node >/dev/null || fail "Node.js is needed: run ./plm install"
  http_ok "$API_URL/actuator/health" || fail "The platform isn't running: ./plm start first"
  if [[ -z "${PLM_ADMIN_PASSWORD:-}" ]]; then
    [[ -t 0 ]] || fail "Set PLM_ADMIN_PASSWORD to $ADMIN_USER's password"
    read -r -s -p "  $ADMIN_USER's password: " PLM_ADMIN_PASSWORD </dev/tty
    echo
  fi
  PLM_ADMIN_PASSWORD="$PLM_ADMIN_PASSWORD" PLM_API_URL="$API_URL" PLM_OIDC_ISSUER="$KEYCLOAK/realms/plm" \
    node "$ROOT/scripts/demo-data/load.mjs" "$@"
}

cmd_install() {
  bold "Installing the PLM platform on this computer"
  [[ "$DRY_RUN" == 1 ]] && echo "  (dry run: nothing is installed or changed)"
  ensure_prerequisites
  if [[ "$DRY_RUN" == 1 ]]; then
    echo
    bold "Then: install the web UI's packages, build the backend, start everything, ask for $ADMIN_USER's password."
    return 0
  fi
  start_everything
  if set_admin_password ask; then ready_message set; else ready_message; fi
}

cmd_stop() {
  bold "Stopping"
  stop_process ui
  stop_process backend
  "${COMPOSE[@]}" --profile full stop >/dev/null 2>&1 && ok "services stopped (data kept)" || warn "No services to stop"
}

cmd_status() {
  bold "Platform status"
  if running ui; then ok "Web UI      $UI_URL (pid $(pid_of ui))"; else warn "Web UI      not running"; fi
  if running backend && http_ok "$API_URL/actuator/health"; then
    ok "Backend     $API_URL (pid $(pid_of backend))"
  elif running backend; then
    warn "Backend     starting (pid $(pid_of backend))"
  else
    warn "Backend     not running"
  fi
  local name port
  for pair in PostgreSQL:5432 Keycloak:8180 S3:8333 Redpanda:19092 Mailpit:8025 OpenSearch:9200 Temporal:7233; do
    name="${pair%%:*}"
    port="${pair##*:}"
    if port_open "$port"; then ok "$(printf '%-11s :%s' "$name" "$port")"; else warn "$(printf '%-11s not running' "$name")"; fi
  done
}

cmd_logs() {
  case "${1:-backend}" in
    backend) tail -n 100 -f "$STATE/backend.log" ;;
    ui) tail -n 100 -f "$STATE/ui.log" ;;
    services) "${COMPOSE[@]}" --profile full logs -f --tail 100 ;;
    *) fail "Which log: backend, ui or services" ;;
  esac
}

cmd_reset() {
  read -r -p "This deletes all local data (database, files, search index, passwords). Type 'reset' to go on: " answer
  [[ "$answer" == "reset" ]] || fail "Nothing deleted"
  stop_process ui
  stop_process backend
  "${COMPOSE[@]}" --profile full down -v
  ok "Everything stopped, all local data deleted. ./plm install begins afresh."
}

case "${1:-}" in
  install) cmd_install ;;
  setup)
    check_prerequisites
    install_dependencies
    build_backend
    bold "Ready: ./plm start"
    ;;
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart)
    cmd_stop
    cmd_start
    ;;
  status) cmd_status ;;
  logs) cmd_logs "${2:-backend}" ;;
  admin-password) cmd_admin_password ;;
  load-data)
    shift
    cmd_load_data "$@"
    ;;
  reset) cmd_reset ;;
  *)
    sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
