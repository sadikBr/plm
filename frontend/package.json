{
  "name": "plm-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen:api": "openapi-typescript ../api/openapi.json -o src/api/schema.d.ts",
    "predev": "npm run gen:api",
    "dev": "vite",
    "prebuild": "npm run gen:api",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run gen:api",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "pretest": "npm run gen:api",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --trace off"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.106.0",
    "lucide-react": "^1.68.0",
    "oidc-client-ts": "^3.5.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-oidc-context": "^3.3.1",
    "react-router": "^8.5.1",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
